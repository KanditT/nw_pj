# Normalize line endings
* text=auto

# Force LF for files used in Docker/Linux containers
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.css text eol=lf

# Force CRLF for Windows-specific files
*.sln text eol=crlf
*.csproj text eol=crlf
*.cs text eol=crlf
*.axaml text eol=crlf
